IDA_LOG_LEVEL=INFO
IDA_DATA_DIR=data
IDA_FHIR_BASE_URL=http://127.0.0.1:8765/fhir
# Compose overrides these internally; keep false for ordinary host development.
IDA_FHIR_ALLOW_COMPOSE_HOST=false
IDA_STARTUP_ATTEMPTS=20
IDA_STARTUP_DELAY_SECONDS=1
# Published host ports only; service-to-service ports stay fixed.
IDA_API_PORT=8000
IDA_FHIR_PORT=8765
IDA_POSTGRES_PORT=5433
IDA_UI_PORT=8501
# Host Streamlit only; Compose uses http://api:8000 internally.
IDA_UI_API_URL=http://127.0.0.1:8000
IDA_UI_TIMEOUT_SECONDS=180

# Payloads in SDK traces and provider response storage require explicit opt-in.
IDA_TRACE_INCLUDE_PAYLOADS=false
IDA_STORE_MODEL_RESPONSES=false
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Local PostgreSQL/pgvector. Choose a local password; never commit .env.
POSTGRES_PASSWORD=
# Host Python commands only; Compose constructs its internal URL from POSTGRES_PASSWORD.
# Set the URL with the same password (URL-encode any reserved characters).
DATABASE_URL=
# Example shape: postgresql://ida_demo:<password>@127.0.0.1:5433/ida_guidelines
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
IDA_EMBEDDING_DIMENSIONS=1536
IDA_CHUNK_WORDS=120
IDA_CHUNK_OVERLAP=20

# Opt-in integration tests only: point at a separate disposable pgvector database.
IDA_TEST_DATABASE_URL=

# Demo reviewer identity selected by the server; this is NOT authentication.
IDA_CURRENT_USER_ID=REVIEWER_001
# Assigned synthetic patients only; a missing reviewer assignment denies all access.
IDA_PATIENT_ASSIGNMENTS={"REVIEWER_001":["PATIENT_001"],"REVIEWER_002":["PATIENT_002","PATIENT_003"]}
