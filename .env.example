IDA_LOG_LEVEL=INFO
IDA_DATA_DIR=data
IDA_FHIR_BASE_URL=http://127.0.0.1:8765/fhir

# The agent demo exports detailed synthetic payloads in SDK traces.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Local PostgreSQL/pgvector. Choose a local password; never commit .env.
POSTGRES_PASSWORD=
# Set the URL with the same password (URL-encode any reserved characters).
DATABASE_URL=
# Example shape: postgresql://ida_demo:<password>@127.0.0.1:5433/ida_guidelines
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
IDA_EMBEDDING_DIMENSIONS=1536
IDA_CHUNK_WORDS=120
IDA_CHUNK_OVERLAP=20

# Opt-in integration tests only: point at a separate disposable pgvector database.
IDA_TEST_DATABASE_URL=
